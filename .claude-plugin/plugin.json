{
  "name": "huhhb",
  "version": "0.4.2",
  "description": "Uhstray.io skills marketplace — curated Claude Code skills including uhh:memory.",
  "author": {
    "name": "Uhstray.io",
    "url": "https://github.com/uhstray-io"
  },
  "license": "MIT",
  "mcpServers": {
    "memory": {
      "command": "uvx",
      "args": ["mempalace-mcp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/explain-changes-activate.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/precommit-explain.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "keywords": ["memory", "skills", "ai", "uhstray", "marketplace"],
  "repository": "https://github.com/uhstray-io/huhhb"
}
