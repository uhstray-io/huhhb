{
  "name": "huhhb",
  "version": "0.7.18",
  "description": "Uhstray.io skills marketplace \u2014 curated Claude Code skills including uhh:memory.",
  "author": {
    "name": "Uhstray.io",
    "url": "https://github.com/uhstray-io"
  },
  "license": "MIT",
  "mcpServers": {
    "memory": {
      "command": "uvx",
      "args": [
        "mempalace-mcp"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/explain-changes-activate.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/repo-memory-load.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/evolve-inject.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/precommit-explain.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/repo-memory-lint.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/evolve-capture.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/grounding-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$0\" ] && exec sh \"$0\" || exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/repo-memory-pr-consolidate.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "keywords": [
    "memory",
    "skills",
    "ai",
    "uhstray",
    "marketplace"
  ],
  "repository": "https://github.com/uhstray-io/huhhb"
}
